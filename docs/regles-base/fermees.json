{
  "rules": {
    "listes": {
      ".read": "auth != null && root.child('profils').child(auth.uid).val() === 'ferme'",
      ".write": "auth != null && root.child('profils').child(auth.uid).val() === 'ferme'",
      "reglages": {
        "debouches": {
          ".read": "auth != null && root.child('profils').child(auth.uid).val() === 'agent'"
        }
      }
    },
    "profils": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "magasins": {
      ".read": "auth != null && root.child('profils').child(auth.uid).val() === 'ferme'",
      "$did": {
        "semaines": {
          ".read": "auth != null && root.child('profils').child(auth.uid).val() === 'magasin:' + $did",
          "$w": {
            "$pid": {
              ".write": "auth != null && root.child('profils').child(auth.uid).val() === 'magasin:' + $did && $w.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.hasChildren(['n', 'u', 'by', 'at'])",
              "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000" },
              "u": { ".validate": "newData.val() === 'colis' || newData.val() === 'kg' || newData.val() === 'u'" },
              "by": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
              "at": { ".validate": "newData.isNumber()" },
              "$autre": { ".validate": false }
            }
          }
        },
        "personnes": {
          ".read": "auth != null && root.child('profils').child(auth.uid).val() === 'magasin:' + $did",
          "$cle": {
            ".write": "auth != null && root.child('profils').child(auth.uid).val() === 'magasin:' + $did && newData.exists()",
            ".validate": "newData.hasChildren(['nom', 'at'])",
            "nom": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "at": { ".validate": "newData.isNumber()" },
            "$autre": { ".validate": false }
          }
        },
        "suivi": {
          ".write": "auth != null && root.child('profils').child(auth.uid).val() === 'magasin:' + $did && newData.exists()",
          ".validate": "newData.hasChildren(['w', 'at', 'by', 'n'])",
          "w": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "at": { ".validate": "newData.isNumber()" },
          "by": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000" },
          "manque": { "$i": { ".validate": "newData.isString() && newData.val().length <= 80" } },
          "$autre": { ".validate": false }
        },
        "journal": {
          "$w": {
            "$jid": {
              ".write": "auth != null && root.child('profils').child(auth.uid).val() === 'magasin:' + $did && !data.exists() && $w.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.hasChildren(['pid', 'by', 'at'])",
              "pid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "n": { ".validate": "newData.isNumber()" },
              "u": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "an": { ".validate": "newData.isNumber()" },
              "au": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "by": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
              "at": { ".validate": "newData.isNumber()" },
              "$autre": { ".validate": false }
            }
          }
        }
      }
    },
    "notifs": {
      "ferme": {
        ".read": "auth != null && root.child('profils').child(auth.uid).val() === 'ferme'",
        "$id": {
          ".write": "auth != null && newData.exists() && (!data.exists() || data.child('at').val() === newData.child('at').val()) && (root.child('profils').child(auth.uid).val() === 'magasin:' + newData.child('did').val() || (root.child('profils').child(auth.uid).val() === 'ferme' && newData.child('auto').val() === true))",
          ".validate": "newData.hasChildren(['type', 'did', 'w', 'by', 'n', 'at']) && $id.length <= 120",
          "type": { ".validate": "newData.val() === 'stock-fini'" },
          "did": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "w": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "by": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000" },
          "at": { ".validate": "newData.isNumber()" },
          "auto": { ".validate": "newData.isBoolean()" },
          "manque": { "$i": { ".validate": "newData.isString() && newData.val().length <= 80" } },
          "$autre": { ".validate": false }
        }
      },
      "magasin": {
        "$did": {
          ".read": "auth != null && (root.child('profils').child(auth.uid).val() === 'ferme' || root.child('profils').child(auth.uid).val() === 'magasin:' + $did)",
          "$id": {
            ".write": "auth != null && root.child('profils').child(auth.uid).val() === 'ferme' && newData.exists() && (!data.exists() || data.child('at').val() === newData.child('at').val())",
            ".validate": "newData.hasChildren(['type', 'w', 'by', 'n', 'at']) && $id.length <= 120",
            "type": { ".validate": "newData.val() === 'liste-misealajour'" },
            "w": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "by": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000" },
            "at": { ".validate": "newData.isNumber()" },
            "$autre": { ".validate": false }
          }
        }
      }
    },
    "agent": {
      "propositions": {
        ".read": "auth != null && (root.child('profils').child(auth.uid).val() === 'ferme' || root.child('profils').child(auth.uid).val() === 'agent')",
        ".indexOn": ["w"],
        "$id": {
          ".write": "auth != null && root.child('profils').child(auth.uid).val() === 'agent' && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['w', 'c', 'cle', 'src', 'date', 'type', 'by', 'at']) && $id.matches(/^[A-Za-z0-9_-]{1,120}$/)",
          "w": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "c": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "cle": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "src": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "lien": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')" },
          "date": { ".validate": "newData.isNumber()" },
          "type": { ".validate": "newData.val() === 'commande' || newData.val() === 'annulation'" },
          "l": {
            "$i": {
              ".validate": "$i.matches(/^1?[0-9]?[0-9]$/) && newData.hasChildren(['p', 'n', 'u'])",
              "p": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "nom": { ".validate": "newData.isString() && newData.val().length <= 80" },
              "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000" },
              "u": { ".validate": "newData.val() === 'colis' || newData.val() === 'kg' || newData.val() === 'u'" },
              "$autre": { ".validate": false }
            }
          },
          "refus": { "$i": { ".validate": "$i.matches(/^1?[0-9]$/) && newData.isString() && newData.val().length <= 120" } },
          "verif": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "by": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "at": { ".validate": "newData.isNumber()" },
          "$autre": { ".validate": false }
        }
      }
    }
  }
}
